$TTL 300
@ IN SOA ns1.example.net. hostmaster.example.net. (
  2026083101 3600 1800 604800 300 )
@ IN NS ns1.example.net.
@ IN NS ns2.example.net.
@ IN MX 10 mail.example.net.
ns1 IN A 198.51.100.10
ns2 IN A 198.51.100.11
mail IN A 198.51.100.25
www IN A 198.51.100.30
@ IN TXT "v=spf1 mx ip4:198.51.100.25 -all"
_dmarc IN TXT "v=DMARC1; p=quarantine"
mail._domainkey IN TXT "v=DKIM1; k=rsa; p=<PUBLIC_KEY_ONLY>"
